PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
DATABASE_FILE=./database/certified-developer-test.db

# These are only used when creating new accounts or replacing an invalid
# first-login credential. Existing administrator passwords are never reset.
OWNER_INITIAL_PASSWORD=configure-outside-source-control
STUDENT_INITIAL_PASSWORD=configure-outside-source-control
TEACHER_INITIAL_PASSWORD=configure-outside-source-control

# Password-recovery code hashing secret (generate a unique random value of at least 32 characters).
PASSWORD_RESET_PEPPER=

# Gmail SMTP password recovery. Use a Gmail app password, not your account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
